POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Optional. Omit or leave empty to leave first-run setup open, so the first
# account created becomes the owner. Set it — 24 characters or more — for any
# deployment strangers can reach, because whoever completes setup becomes the
# system administrator. Either way, setup refuses once a user exists.
COORD_BOOTSTRAP_TOKEN=replace-with-a-bootstrap-token-at-least-24-characters-long
# Encrypts every user's stored provider and GitHub credential. 32 bytes as
# base64 or hex; anything else is stretched. Leave it unset and one is
# generated beside the credential file — which ties those credentials to that
# directory, so a deployment whose disk does not survive a restart loses them.
# Generate one with: openssl rand -base64 32
COORD_CREDENTIAL_KEY=
# Where per-task vendor credential homes are staged. Codex refuses to create
# PATH-alias helper binaries when CODEX_HOME sits under /tmp, so production
# images point this at a writable cache directory outside /tmp. Unset uses the
# process temp directory, which is fine for local development and tests.
COORD_CREDENTIAL_STAGING=
# Forces the Secure flag on session cookies. Leave unset for a plain-HTTP
# trial: cookies are marked Secure automatically on any request that arrived
# over TLS, and forcing it on plain HTTP stops sign-in from working at all.
COORD_SECURE_COOKIES=true
COORD_ALLOWED_ORIGINS=
# What a task does when its submitter has connected no provider account.
# `refuse` (the default) fails the task; `host-login` falls back to this
# machine's own CLI login, which means one person's task spends the host
# owner's subscription. Set host-login only on a single-operator deployment.
COORD_CREDENTIAL_POLICY=refuse
# Self-service sign-up is open by default, so anyone with the deployment link
# can create an account with their own isolated organization and project. Set
# this to 0 to require invitations instead.
COORD_ALLOW_REGISTRATION=
# Where registration confirmation codes and "Forgotten your password?" links
# are sent. Set one of the two transports below, or nobody ever receives the
# sign-up code. Step-by-step setup: docs/email-setup.md.
#
# With neither transport set, messages are written to the log instead, which is
# recoverable on a single-operator deployment and useless on any other.
#
# A mail provider's HTTPS API. Prefer this on a hosting platform that blocks
# outbound SMTP ports (Railway, Fly, most serverless hosts), where an SMTP
# relay simply times out. Any endpoint taking {from, to, subject, text} works —
# Resend is https://api.resend.com/emails. COORD_MAIL_FROM must be an address
# the provider has verified.
COORD_MAIL_API_URL=
COORD_MAIL_API_KEY=
# Or an SMTP relay, used when no API URL is set. smtp://user:password@host:587
# negotiates STARTTLS when the relay offers it, smtps://... is TLS from the
# first byte. Percent-encode an @ in the password.
COORD_SMTP_URL=
# The From address on those messages. Empty means no-reply@<the mail host>, which
# most relays and providers refuse to send as — set the address they authorised.
COORD_MAIL_FROM=
# Absolute origin this deployment is reached at, used to build the reset link.
# Empty falls back to the Host header of the request that asked for the link,
# which is fine behind a router that sets it and wrong wherever it can be
# spoofed. Example: https://latt.up.railway.app
COORD_PUBLIC_URL=
# How long a reset link works for, in minutes. Empty means 60. Requesting a
# new link always invalidates the previous one, whatever this is set to.
COORD_PASSWORD_RESET_TTL_MINUTES=
# How long a plan written by /plan waits for somebody to say "go ahead", in
# minutes. Empty means 15. When it runs out the plan is let go and the thread
# says so; nothing has run by then, so asking again simply plans it afresh.
COORD_PLAN_HOLD_TTL_MINUTES=
# How many proxies sit in front of this control plane. 0 (the default) ignores
# X-Forwarded-For entirely; set it to the real number when a platform router or
# your own reverse proxy terminates TLS, or every request shares one rate-limit
# bucket and one client can lock everybody out of sign-in. Setting it higher
# than the truth lets clients choose their own bucket.
COORD_TRUSTED_PROXY_HOPS=
# Strict-Transport-Security lifetime in seconds, sent only on requests that
# arrived over TLS. Empty means one year; 0 turns it off. Browsers remember it
# for the domain, so turn it off before serving that domain over plain HTTP.
COORD_HSTS=
# "1" makes this deployment refuse to run agents itself: every task is left
# for a registered worker on somebody's own machine, and one whose owner has
# no machine listening waits rather than running here. Memory and egress are
# almost entirely agents, so this is what moves the expensive half of a hosted
# bill onto the hardware the work is for. Empty leaves the control plane as an
# executor, which is what a single-box install needs.
COORD_LOCAL_AGENTS_ONLY=
# "1" answers a desktop browser asking for the dashboard with a redirect to
# /download. Phones still reach it — there is no mobile build to send them to
# — and the desktop app marks its own User-Agent so it is let through. This
# only decides which page somebody lands on; COORD_LOCAL_AGENTS_ONLY above is
# what actually stops this deployment doing the work.
COORD_DESKTOP_APP_ONLY=
# UID:GID the Docker sandbox runs containers as. Empty means the user this
# control plane runs as, which owns the worktree being mounted. Set it only for
# an image whose entrypoint genuinely needs root.
COORD_SANDBOX_USER=
# Optional. Client ID of a GitHub OAuth App with "Enable Device Flow" ticked
# (github.com -> Settings -> Developer settings -> OAuth Apps). Turns on
# "Sign in with GitHub" for connecting push credentials; no client secret is
# needed. Empty offers the pasted-token path only.
COORD_GITHUB_CLIENT_ID=

# --- Billing (off unless you switch it on) ----------------------------------
# The master switch. Unset or 0 means this deployment takes no payments at
# all: public sign-up is a waitlist, checkout and the billing portal answer
# 501, no Stripe webhook is accepted, no trial runs, and nothing is gated on a
# subscription — every organization keeps full use of its repositories.
# People are let in one at a time, by approving them on the waitlist in
# Settings — Deployment, which lets that address (and only that address)
# create its own free account.
#
# Set it to 1 to switch the payment pathway back on. The four Stripe settings
# below are only read when it is on.
KUMI_PAYMENTS_ENABLED=
#
# With payments on and these empty, every billing route still answers 501, the
# Settings screen says so, and nobody is gated. That is a supported way to run
# Kumi, and it is what self-hosting means here.
#
# Stripe secret key. Test-mode keys start sk_test_ and charge nothing real, so
# do the first end-to-end run with one.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint, from the same dashboard page where
# the endpoint is created (it starts whsec_). Without it every webhook is
# refused rather than trusted — the deployment cannot tell a real event from a
# forged one, and anyone who found the URL could otherwise cancel a
# subscription. The endpoint to register is:
#   https://<your-domain>/api/v1/stripe/webhook
# subscribed to: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# The price a seat is sold at — starts price_, not prod_. The product holds the
# name; the price holds the amount, and it is the price a checkout references.
# Create it as Recurring / Monthly / Licensed (licensed is the per-seat kind
# that takes a quantity; metered is not what this bills).
STRIPE_PRICE_ID=
# Where Stripe sends a browser back to after checkout, e.g. https://kumi.app —
# no trailing slash needed, one is trimmed. Configured rather than taken from
# the request because the desktop shell's own origin is not somewhere Stripe
# can redirect to. Falls back to COORD_PUBLIC_URL, then the first allowed
# origin, so a plain web deployment usually needs nothing here.
KUMI_APP_URL=
