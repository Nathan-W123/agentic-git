{
  "name": "@coord/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "bin": { "coord-worker": "./dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@coord/adapter-codex": "*",
    "@coord/adapter-prompt-cli": "*",
    "@coord/adapter-generic-cli": "*",
    "@coord/agent-protocol": "*",
    "@coord/cli": "*",
    "@coord/persistence": "*",
    "@coord/repository-service": "*",
    "@coord/shared-types": "*",
    "@coord/workspace-manager": "*"
  },
  "//": "@coord/api-gateway is a test-only import (worker.test.ts builds an in-process gateway to run the protocol against). It is a devDependency and must stay one: as a runtime dependency it drags @coord/local-triage -> @huggingface/transformers -> onnxruntime-node, over 600 MB of native ML that a worker never loads, into anything that packages this worker for a desktop.",
  "devDependencies": {
    "@coord/api-gateway": "*"
  }
}
