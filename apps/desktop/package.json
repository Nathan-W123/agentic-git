{
  "name": "@coord/desktop",
  "version": "0.5.16",
  "private": true,
  "description": "Kumi as a desktop app: a window onto your deployment, signed in through your browser.",
  "author": "Kumi",
  "homepage": "https://github.com/Nathan-W123/Kumi",
  "type": "module",
  "main": "electron/main.mjs",
  "desktopName": "kumi.desktop",
  "exports": {
    ".": "./dist/index.js",
    "./electron": "./electron/main.mjs"
  },
  "kumi": {
    "releasesRepo": "Nathan-W123/Kumi",
    "defaultServer": "https://kumi.up.railway.app"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "desktop": "electron electron/main.mjs",
    "package": "electron-builder --config electron-builder.yml"
  }
}
