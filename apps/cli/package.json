{
  "name": "@coord/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./commands": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./repo-export": {
      "types": "./dist/repo-export.d.ts",
      "default": "./dist/repo-export.js"
    },
    "./worker-operations": {
      "types": "./dist/worker-operations.d.ts",
      "default": "./dist/worker-operations.js"
    },
    "./remote-holders": {
      "types": "./dist/remote-holders.d.ts",
      "default": "./dist/remote-holders.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "default": "./dist/recovery.js"
    },
    "./rollback": {
      "types": "./dist/rollback.d.ts",
      "default": "./dist/rollback.js"
    },
    "./verification": {
      "types": "./dist/verification.d.ts",
      "default": "./dist/verification.js"
    }
  },
  "bin": {
    "coord": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@coord/adapter-codex": "*",
    "@coord/adapter-prompt-cli": "*",
    "@coord/adapter-generic-cli": "*",
    "@coord/agent-protocol": "*",
    "@coord/coordinator": "*",
    "@coord/integration-service": "*",
    "@coord/persistence": "*",
    "@coord/repository-service": "*",
    "@coord/shared-types": "*",
    "@coord/workspace-manager": "*"
  }
}
